# The workharbor console on Ubuntu LTS (design D43): the stock image pinned by digest,
# the tools for the human's shell work, and the git wrapper that runs git safely in a
# workspace whose .git an agent wrote. No Docker CLI and no container engine, no
# credentials. The digest is the one of the base image (internal/baseimage); changing
# either file changes the image's tag, so the next start builds it again.
FROM docker.io/library/ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git zsh fish jq curl ripgrep tmux vim-tiny make less util-linux procps ca-certificates openssh-server openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && (id ubuntu >/dev/null 2>&1 && userdel -r ubuntu || true) \
    && useradd -u 1000 -m -s /bin/zsh workharbor
COPY whr-git /usr/local/bin/git
RUN chmod 0755 /usr/local/bin/git
# The BundleDock shared shell layer (Git/jj shortcuts and the starship prompt, the
# same in zsh, bash, fish and Nushell), dormant until the toolbox is mounted read-only
# at /opt/bundledock/toolbox. The toolbox's bin goes last on PATH, so it never shadows
# the git wrapper or the image's tools; its share goes first in XDG_DATA_DIRS, where
# fish and Nushell find their files. HOME here is the human's own volume, and every
# git the prompt or a shortcut runs goes through the wrapper.

# The console's sshd (issue #32): started by the supervisor as the console user, with
# the certificate authority's public key in WHR_SSH_CA. The configuration is in the
# image; a login shell reads the proxy variables whr-sshd leaves in /tmp/whr-proxy-vars.
COPY whr-sshd /usr/local/bin/whr-sshd
COPY sshd_config /etc/whr/sshd_config
RUN chmod 0755 /usr/local/bin/whr-sshd \
    && chmod 0644 /etc/whr/sshd_config \
    && printf '%s\n' '[ -r /tmp/whr-proxy-vars ] && . /tmp/whr-proxy-vars' > /etc/profile.d/whr-env.sh \
    && mkdir -p /etc/zsh \
    && printf '%s\n' 'case ":$PATH:" in *:/opt/bundledock/toolbox/bin:*) ;; *) [ -d /opt/bundledock/toolbox/share ] && { PATH=$PATH:/opt/bundledock/toolbox/bin; XDG_DATA_DIRS=/opt/bundledock/toolbox/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; export PATH XDG_DATA_DIRS; } ;; esac' > /etc/profile.d/whr-toolbox.sh \
    && printf '%s\n' '[ -r /opt/bundledock/toolbox/share/shell/init.zsh ] && . /opt/bundledock/toolbox/share/shell/init.zsh' >> /etc/zsh/zshrc \
    && printf '%s\n' '[ -r /opt/bundledock/toolbox/share/shell/init.bash ] && . /opt/bundledock/toolbox/share/shell/init.bash' >> /etc/bash.bashrc \
    && printf '%s\n' '[ -r /tmp/whr-proxy-vars ] && . /tmp/whr-proxy-vars' 'case ":$PATH:" in *:/opt/bundledock/toolbox/bin:*) ;; *) [ -d /opt/bundledock/toolbox/share ] && { PATH=$PATH:/opt/bundledock/toolbox/bin; XDG_DATA_DIRS=/opt/bundledock/toolbox/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; export PATH XDG_DATA_DIRS; } ;; esac' >> /etc/zsh/zshenv
