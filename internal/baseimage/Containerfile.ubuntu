# The workharbor base image on Ubuntu LTS (design D44, D43): the stock image
# pinned by digest, plus git and CA certificates, and nothing else. The agent
# CLIs stay in the tool store. Changing the digest changes the image's tag, so
# the next start builds it again.
FROM docker.io/library/ubuntu@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
